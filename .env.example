# Public Supabase browser configuration. Never put a service-role or secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects can use this instead of VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY=

# Canonical course platform. Registration, sign-in, checkout, and learner
# progress continue there until zenai.world and the course runtime share a host.
VITE_COURSE_BASE_URL=https://us-ai-literacy.lovable.app

# Optional secure intake endpoint. When unset, the public form fails safely into
# the canonical course registration route and never grants access client-side.
VITE_PROGRAM_REGISTRATION_ENDPOINT=

# Public Notion-backed knowledge routes stay closed unless this server-only flag
# is deliberately enabled after the source has been reviewed for public access.
ZEN_PUBLIC_KNOWLEDGE_ENABLED=false
